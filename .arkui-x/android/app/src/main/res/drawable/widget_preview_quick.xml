        android:fillColor="#FFFFFF"
        android:pathData="M16,0 L184,0 A16,16 0 0 1 200,16 L200,184 A16,16 0 0 1 184,200 L16,200 A16,16 0 0 1 0,184 L0,16 A16,16 0 0 1 16,0 Z"
        android:strokeColor="#E5E5EB"
        android:strokeWidth="1" />

    <!-- 标题与更新时间 -->
    <path
        android:fillColor="#0A8471"
        android:pathData="M14,14 h46 a3,3 0 0 1 3,3 v3 a3,3 0 0 1 -3,3 h-46 a3,3 0 0 1 -3,-3 v-3 a3,3 0 0 1 3,-3 Z" />
    <path
        android:fillAlpha="0.3"
        android:fillColor="#6C6C78"
        android:pathData="M150,15 h36 a2,2 0 0 1 2,2 v2 a2,2 0 0 1 -2,2 h-36 a2,2 0 0 1 -2,-2 v-2 a2,2 0 0 1 2,-2 Z" />

    <!-- 第 1 行：名称 / 百分比（用量 82%）+ 用量条 + 重置倒计时 -->
