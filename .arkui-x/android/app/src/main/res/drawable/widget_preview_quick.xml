        android:fillAlpha="0.35"
        android:fillColor="#6C6C78"
        android:pathData="M14,40 h50 a2,2 0 0 1 2,2 v3 a2,2 0 0 1 -2,2 h-50 a2,2 0 0 1 -2,-2 v-3 a2,2 0 0 1 2,-2 Z" />
    <path
