    <path
        android:fillAlpha="0.35"
        android:fillColor="#6C6C78"
        android:pathData="M14,82 h38 a2,2 0 0 1 2,2 v3 a2,2 0 0 1 -2,2 h-38 a2,2 0 0 1 -2,-2 v-3 a2,2 0 0 1 2,-2 Z" />
