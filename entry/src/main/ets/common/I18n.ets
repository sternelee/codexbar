/** 服务商/模型层文案按当前语言翻译：英文查表，未收录与中文模式均原样返回 */
export function LT(text: string): string {
  if (currentLang() !== 'en') {
    return text;
  }
  const t = PROVIDER_TEXTS[text];
  return t !== undefined ? t : text;
}
